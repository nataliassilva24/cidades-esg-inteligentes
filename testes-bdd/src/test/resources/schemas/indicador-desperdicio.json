{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Indicador ESG - desperdício evitado (exames repetidos)",
  "type": "object",
  "required": ["periodoAnalisado", "examesRepetidosEvitados", "economiaEstimadaReais", "descricao", "impactoESG"],
  "properties": {
    "periodoAnalisado":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} a \\d{4}-\\d{2}-\\d{2}$" },
    "examesRepetidosEvitados": { "type": "integer", "minimum": 0 },
    "economiaEstimadaReais":   { "type": "number", "minimum": 0 },
    "descricao":               { "type": "string", "minLength": 1 },
    "impactoESG":              { "type": "string", "pattern": "^Dimensão (Ambiental|Social|Governança)" }
  },
  "additionalProperties": false
}
