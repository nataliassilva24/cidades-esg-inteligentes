{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ErrorResponse de validação (400) - deve listar os campos com erro",
  "type": "object",
  "required": ["timestamp", "status", "error", "message", "path", "errors"],
  "properties": {
    "timestamp": { "type": "string" },
    "status":    { "type": "integer", "enum": [400] },
    "error":     { "type": "string", "enum": ["Bad Request"] },
    "message":   { "type": "string", "minLength": 1 },
    "path":      { "type": "string", "pattern": "^/" },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["campo", "mensagem"],
        "properties": {
          "campo":    { "type": "string", "minLength": 1 },
          "mensagem": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
