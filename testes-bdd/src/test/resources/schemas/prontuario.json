{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "ProntuarioResponse",
  "type": "object",
  "required": ["id", "pacienteId", "nomePaciente", "medicoId", "nomeMedico", "dataAtendimento", "diagnostico"],
  "properties": {
    "id":              { "type": "integer", "minimum": 1 },
    "pacienteId":      { "type": "integer", "minimum": 1 },
    "nomePaciente":    { "type": "string", "minLength": 1 },
    "medicoId":        { "type": "integer", "minimum": 1 },
    "nomeMedico":      { "type": "string", "minLength": 1 },
    "dataAtendimento": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "diagnostico":     { "type": "string", "minLength": 1, "maxLength": 500 },
    "prescricao":      { "type": ["string", "null"], "maxLength": 1000 },
    "observacoes":     { "type": ["string", "null"], "maxLength": 1000 }
  },
  "additionalProperties": false
}
