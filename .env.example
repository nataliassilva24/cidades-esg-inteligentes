# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# --- Banco de dados (MySQL) ---
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=healthtrack
MYSQL_USER=healthtrack_app
MYSQL_PASSWORD=troque-esta-senha

# --- Segurança (assinatura dos tokens JWT; mínimo 32 caracteres) ---
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# --- Aplicação ---
APP_ENV=local
APP_VERSION=dev
APP_PORT=8080
